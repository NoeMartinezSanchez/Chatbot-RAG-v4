# =============================================================================
# .env.example - Copiar a .env y llenar valores reales
# -----------------------------------------------------------------------------
# Uso:
#   cp .env.example .env    # Linux/Mac
#   copy .env.example .env  # Windows
#
# En Hugging Face Spaces: añadir estas variables en Settings > Variables and
# secrets (NO crear archivo .env). Verificar con:
#   python scripts/verify_hf_spaces.py
# =============================================================================

# === MongoDB ===
# Obligatoria si MongoDB está habilitado. Cluster Atlas: mongodb+srv://...
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB_NAME=chatbot_rag_db
MONGODB_ENABLE_LOGGING=true
MONGODB_RETRY_WRITES=true
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# === Cache ===
RAG_CACHE_TTL_HOURS=24
RAG_CACHE_ENABLED=true

# === Retención (días) ===
RETENTION_CONVERSATIONS_DAYS=90
RETENTION_METRICS_DAYS=30
RETENTION_LOGS_DAYS=14
RETENTION_FEEDBACK_DAYS=180

# === API / Admin ===
# Recomendada: protege los endpoints /admin/cleanup y /admin/dashboard-report.
# Si se deja vacía, los endpoints /admin/* quedan abiertos.
ADMIN_API_KEY=tu_clave_segura_aqui
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=America/Mexico_City

# === Modelos ===
# Obligatoria: API key de Groq (GPT OSS 120B).
GROQ_API_KEY=tu_groq_api_key

# === Monitoreo / Alertas Telegram (opcional) ===
# Si se configuran, los incidentes de seguridad high/critical y las alertas de
# monitoreo envían mensajes al bot. Sin token/chat id → degradación silenciosa.
# TELEGRAM_BOT_TOKEN=tu_token_del_bot
# TELEGRAM_CHAT_ID=tu_chat_id

# === CI/CD (opcional, solo GitHub Actions) ===
# HF_TOKEN=tu_hf_token
